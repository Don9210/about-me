      <p>Boston University · Questrom School of Business</p>
      <div class="tags">
        <span class="tag">Operations &amp; Supply Chain</span>
        <span class="tag">Business Analytics</span>
        <span class="tag">4학년 (Senior)</span>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h3>취미</h3>
        <ul>
          <li><span class="num">1</span>축구</li>
          <li><span class="num">2</span>[취미 2]</li>
          <li><span class="num">3</span>[취미 3]</li>
        </ul>
      </div>
      <div class="card">
        <h3>좋아하는 장소</h3>
        <ul>
          <li><span class="num">1</span>[장소 1]</li>
          <li><span class="num">2</span>[장소 2]</li>
          <li><span class="num">3</span>[장소 3]</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="section-label">Projects</div>
    <h2>프로젝트</h2>

    <div class="projects">
      <div class="project">
        <h3>[프로젝트 이름 1]</h3>
        <div class="meta">[과목명 또는 기간]</div>
        <p>[프로젝트 한두 줄 설명]</p>
        <div class="tags">
          <span class="tag">[사용 도구]</span>
          <span class="tag">[키워드]</span>
        </div>
      </div>
      <div class="project">
        <h3>[프로젝트 이름 2]</h3>
        <div class="meta">[과목명 또는 기간]</div>
        <p>[프로젝트 한두 줄 설명]</p>
        <div class="tags">
          <span class="tag">[사용 도구]</span>
          <span class="tag">[키워드]</span>
        </div>
      </div>
      <div class="project">
        <h3>[프로젝트 이름 3]</h3>
        <div class="meta">[과목명 또는 기간]</div>
        <p>[프로젝트 한두 줄 설명]</p>
        <div class="tags">
          <span class="tag">[사용 도구]</span>
          <span class="tag">[키워드]</span>
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="section-label">Contact</div>
    <h2>연락처</h2>

    <div class="contact-list">
      <a class="contact-item" href="mailto:[아이디]@bu.edu">
        <span class="contact-icon">@</span>
        <span><small>Email</small>[아이디]@bu.edu</span>
      </a>
      <a class="contact-item" href="https://www.linkedin.com/in/[아이디]" target="_blank" rel="noopener">
        <span class="contact-icon">in</span>
        <span><small>LinkedIn</small>linkedin.com/in/[아이디]</span>
      </a>
      <a class="contact-item" href="https://github.com/[아이디]" target="_blank" rel="noopener">
        <span class="contact-icon">&lt;/&gt;</span>
        <span><small>GitHub</small>github.com/[아이디]</span>
      </a>
    </div>
  </section>
</main>

<footer>© 2026 Don · Boston University</footer>

<script>
  const toggle = document.getElementById('themeToggle');

  function setTheme(dark) {
    document.body.classList.toggle('dark', dark);
    toggle.textContent = dark ? '☀️' : '🌙';
    toggle.setAttribute('aria-label', dark ? '라이트모드 전환' : '다크모드 전환');
  }

  setTheme(window.matchMedia('(prefers-color-scheme: dark)').matches);

  toggle.addEventListener('click', function () {
    setTheme(!document.body.classList.contains('dark'));
  });

  const links = document.querySelectorAll('.menu a');
  const sections = document.querySelectorAll('main section');

  function updateActive() {
    let current = sections[0].id;
    sections.forEach(function (sec) {
      if (window.scrollY + 90 >= sec.offsetTop) current = sec.id;
    });
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 2) {
      current = sections[sections.length - 1].id;
    }
    links.forEach(function (a) {
      a.classList.toggle('active', a.getAttribute('href') === '#' + current);
    });
  }

  window.addEventListener('scroll', updateActive);
  updateActive();
</script>

</body>
</html>
